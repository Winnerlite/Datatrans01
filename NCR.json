  "statDefinitions": {
    "violence": {
      "label": "Violence",
      "tooltip": "Frequency of violent incidents including robbery, assault, and gang activity in public spaces.",
      "type": "bar",
      "color": "bg-red-500",
      "inverted": true
    },
    "crimeRate": {
      "label": "Crime Rate",
      "tooltip": "Overall reported crime index — petty theft, fraud, and organised criminal activity combined.",
      "type": "bar",
      "color": "bg-red-400",
      "inverted": true
    },
    "civilViolence": {
      "label": "Civil Violence",
      "tooltip": "Risk of civil unrest, protests turning violent, or community clashes.",
      "type": "bar",
      "color": "bg-orange-400",
      "inverted": true
    },
    "safeForWomen": {
      "label": "Safe for Women",
      "tooltip": "How safe women feel moving around the city alone, day or night.",
      "type": "pill",
      "inverted": false
    },
    "safeForRemote": {
      "label": "Safe for Remote Workers",
      "tooltip": "How secure and comfortable remote workers are day-to-day - low harassment risk, reliable public spaces.",
      "type": "pill",
      "inverted": false
    },
    "safeForKids": {
      "label": "Child Moral Safety",
      "tooltip": "Measures the city's moral environment for children — exposure to crime, adult content, drug activity, and street culture. High means a cleaner upbringing.",
      "type": "pill",
      "inverted": false
    },
    "entrepreneurship": {
      "label": "Entrepreneurship",
      "tooltip": "How active and supportive the city is for startups, SMEs, and self-employed individuals.",
      "type": "bar",
      "color": "bg-emerald-500",
      "inverted": false
    },
    "localJobs": {
      "label": "Local Jobs",
      "tooltip": "Availability of formal and informal employment opportunities for residents.",
      "type": "bar",
      "color": "bg-emerald-400",
      "inverted": false
    },
    "remoteWorkers": {
      "label": "Remote Workers",
      "tooltip": "How well the city caters to remote professionals, Freelancers, coworking spaces, and digital infrastructure.",
      "type": "bar",
      "color": "bg-blue-400",
      "inverted": false
    },
    "hustlers": {
      "label": "Hustlers",
      "tooltip": "Street-level economic energy - informal traders, artisans, and entrepreneurs grinding daily.",
      "type": "bar",
      "color": "bg-amber-400",
      "inverted": false
    },
    "priceOfGoods": {
      "label": "Price of Goods & Services",
      "tooltip": "General cost of living, food, household goods, and everyday services.",
      "type": "text",
      "inverted": false
    },
    "commutingPrice": {
      "label": "Commuting Price",
      "tooltip": "Average daily transport cost for a typical resident moving around the city.",
      "type": "text",
      "inverted": false
    },
    "housing": {
      "label": "Housing Affordability",
      "tooltip": "Affordability and availability of accommodation across different budgets.",
      "type": "pill",
      "inverted": false
    },
    "roadConnectivity": {
      "label": "Road Connectivity",
      "tooltip": "Quality and coverage of road networks within and around the city.",
      "type": "bar",
      "color": "bg-blue-500",
      "inverted": false
    },
    "intercityConnect": {
      "label": "Intercity Connectivity",
      "tooltip": "Ease of travelling to and from other major Nigerian cities by road.",
      "type": "bar",
      "color": "bg-indigo-400",
      "inverted": false
    },
    "power": {
      "label": "Power",
      "tooltip": "Reliability of the electricity grid and frequency of outages.",
      "type": "bar",
      "color": "bg-yellow-400",
      "inverted": false
    },
    "internetSpeed": {
      "label": "Internet Speed",
      "tooltip": "Average broadband and mobile data speed available across the city, monthly.",
      "type": "text",
      "inverted": false
    },
    "dominantProvider": {
      "label": "Dominant Provider",
      "tooltip": "The most widely used and reliable internet service provider in this city.",
      "type": "text",
      "inverted": false
    },
    "water": {
      "label": "Water Supply",
      "tooltip": "Reliability and quality of tap water and public water supply infrastructure.",
      "type": "pill",
      "inverted": false
    },
    "nightlife": {
      "label": "Nightlife",
      "tooltip": "Vibrancy of evening entertainment: bars, clubs, restaurants, and after-dark social activity.",
      "type": "bar",
      "color": "bg-purple-400",
      "inverted": false
    },
    "cleanEnvironment": {
      "label": "Clean Environment",
      "tooltip": "Air quality, waste management, and general cleanliness of streets and public areas.",
      "type": "bar",
      "color": "bg-teal-400",
      "inverted": false
    },
    "patriotic": {
      "label": "Patriotic",
      "tooltip": "Sense of civic pride, national identity, and community ownership among residents.",
      "type": "bar",
      "color": "bg-emerald-500",
      "inverted": false
    },
    "religious": {
