    "power":             { "label": "Power",                     "tooltip": "Reliability of the electricity grid and frequency of outages.",                                                                                               "type": "bar",  "color": "bg-yellow-400", "inverted": false },
    "internetSpeed":     { "label": "Internet Speed",            "tooltip": "Average broadband and mobile data speed available across the city, monthly.",                                                                                          "type": "text", "inverted": false },
    "dominantProvider":  { "label": "Dominant Provider",         "tooltip": "The most widely used and reliable internet service provider in this city.",                                                                                   "type": "text", "inverted": false },
    "water":             { "label": "Water Supply",              "tooltip": "Reliability and quality of tap water and public water supply infrastructure.",                                                                                "type": "pill", "inverted": false },
    "nightlife":         { "label": "Nightlife",                 "tooltip": "Vibrancy of evening entertainment: bars, clubs, restaurants, and after-dark social activity.",                                                                "type": "bar",  "color": "bg-purple-400", "inverted": false },
    "cleanEnvironment":  { "label": "Clean Environment",         "tooltip": "Air quality, waste management, and general cleanliness of streets and public areas.",                                                                         "type": "bar",  "color": "bg-teal-400",   "inverted": false },
    "patriotic":         { "label": "Patriotic",                 "tooltip": "Sense of civic pride, national identity, and community ownership among residents.",                                                                           "type": "bar",  "color": "bg-emerald-500","inverted": false },
    "religious":         { "label": "Religious",                 "tooltip": "Strength of religious influence on daily life, business, and culture.",                                                                                       "type": "pill", "inverted": true  },
    "nonReligious":      { "label": "Non-Religious Tolerance",   "tooltip": "How open and tolerant the city is toward non-religious or secular lifestyles.",                                                                               "type": "pill", "inverted": false },
    "tribalism":         { "label": "Tribalism",                 "tooltip": "Level of ethnic tension or preferential treatment based on tribe or ethnicity.",                                                                              "type": "pill", "inverted": true  },
    "povertyIndex":      { "label": "Poverty Index",             "tooltip": "Proportion of the population living below a sustainable income threshold.",                                                                                   "type": "pill", "inverted": true  }
