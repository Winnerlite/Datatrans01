    "commutingPrice":    { "label": "Commuting Price",           "tooltip": "Average daily transport cost for a typical resident moving around the city.",                                                                                  "type": "text", "inverted": false },
    "housing":           { "label": "Housing Affordability",     "tooltip": "Affordability and availability of accommodation across different budgets.",                                                                                    "type": "pill", "inverted": false },
    "roadConnectivity":  { "label": "Road Connectivity",         "tooltip": "Quality and coverage of road networks within and around the city.",                                                                                           "type": "bar",  "color": "bg-blue-500",   "inverted": false },
