    "remoteWorkers":     { "label": "Remote Workers",            "tooltip": "How well the city caters to remote professionals, Freelancers, coworking spaces, and digital infrastructure.",                                                     "type": "bar",  "color": "bg-blue-400",   "inverted": false },
    "hustlers":          { "label": "Hustlers",                  "tooltip": "Street-level economic energy-informal traders, artisans, and entrepreneurs grinding daily.",                                                                "type": "bar",  "color": "bg-amber-400",  "inverted": false },
